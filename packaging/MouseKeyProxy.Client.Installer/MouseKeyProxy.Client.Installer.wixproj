<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>MouseKeyProxy-Client</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- WiX v7 OSMF EULA acceptance for build (https://wixtoolset.org/osmf/) -->
    <AcceptEula>wix7</AcceptEula>
    <!-- Staged client-install folder from Nuke PackClientMsi (must end with directory separator). -->
    <ClientInstallDir Condition="'$(ClientInstallDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\output\payloads\client-install\'))</ClientInstallDir>
  </PropertyGroup>

  <!-- Normalize to full path with trailing slash for $(var.ClientInstallDir) in Package.wxs -->
  <PropertyGroup>
    <_ClientInstallFull>$([System.IO.Path]::GetFullPath('$(ClientInstallDir)'))</_ClientInstallFull>
    <_ClientInstallFull Condition="!$(_ClientInstallFull.EndsWith('\'))">$(_ClientInstallFull)\</_ClientInstallFull>
    <!-- WiX preprocessor: $(var.ClientInstallDir)file.exe -->
    <DefineConstants>ClientInstallDir=$(_ClientInstallFull)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
