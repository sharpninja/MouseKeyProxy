# MouseKeyProxy appliance board profile: Orange Pi Zero 2 (Allwinner H616)
MKP_BOARD_ID=orange-pi-zero-2
MKP_BOARD_NAME='Orange Pi Zero 2'
MKP_BOARD_SOC=H616
MKP_BOARD_ARCH=aarch64
MKP_DOTNET_RID=linux-arm64
MKP_BASE_IMAGE_VENDOR=armbian
MKP_BASE_IMAGE_URL=https://dl.armbian.com/orangepizero2/Bookworm_current_minimal
MKP_BASE_IMAGE_CODENAME=bookworm
MKP_BASE_IMAGE_VARIANT=minimal
MKP_HID_BACKEND=physical-configfs
MKP_HID_KEYBOARD_DEVICE=/dev/hidg0
MKP_HID_MOUSE_DEVICE=/dev/hidg1
# Orange Pi Zero 2 USB gadget uses the SoC UDC (often musb-hdrc.*), not Raspberry Pi dwc2.
MKP_GADGET_MODULE_HINTS='libcomposite usb_f_hid usb_f_mass_storage'
MKP_HOSTNAME_DEFAULT=mkp-hid-opi
MKP_USER_DEFAULT=mkp
# HDMI / console (Armbian armbianEnv.txt + firstboot)
MKP_HDMI_ENABLED=1
MKP_HDMI_DISP_MODE=1080p60
MKP_CONSOLE=both
MKP_DASHBOARD_TTY=/dev/tty1
