# MouseKeyProxy appliance board profile: Raspberry Pi Zero 2 W
MKP_BOARD_ID=raspberry-pi-zero-2
MKP_BOARD_NAME='Raspberry Pi Zero 2 W'
MKP_BOARD_SOC=BCM2710A1
MKP_BOARD_ARCH=armv7l
MKP_DOTNET_RID=linux-arm
MKP_BASE_IMAGE_VENDOR=raspberrypi
MKP_BASE_IMAGE_CODENAME=bullseye-or-bookworm
MKP_HID_BACKEND=physical-pi-configfs
MKP_HID_KEYBOARD_DEVICE=/dev/hidg0
MKP_HID_MOUSE_DEVICE=/dev/hidg1
# Raspberry Pi Zero 2 W needs dtoverlay=dwc2,dr_mode=peripheral (not host/otg_mode).
MKP_GADGET_MODULE_HINTS='dwc2 libcomposite usb_f_hid usb_f_mass_storage'
MKP_HOSTNAME_DEFAULT=mkp-hid-pi
MKP_USER_DEFAULT=mkp
