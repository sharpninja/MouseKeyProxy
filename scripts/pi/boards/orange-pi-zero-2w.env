# MouseKeyProxy appliance board profile: Orange Pi Zero 2W 1GB (Allwinner H618 family)
# Distinct from orange-pi-zero-2 (H616 Zero 2 non-W). Wrong image will not boot.
MKP_BOARD_ID=orange-pi-zero-2w
MKP_BOARD_NAME='Orange Pi Zero 2W'
MKP_BOARD_SOC=H618
MKP_BOARD_ARCH=aarch64
MKP_DOTNET_RID=linux-arm64
# Official Xunlong Orange Pi OS images (not Armbian community).
MKP_BASE_IMAGE_VENDOR=orangepi-official
MKP_BASE_IMAGE_URL=https://drive.google.com/drive/folders/1g806xyPnVFyM8Dz_6wAWeoTzaDg3PH4Z
MKP_BASE_IMAGE_FILE=Orangepizero2w_1.0.4_ubuntu_noble_server_linux6.1.31.7z
MKP_BASE_IMAGE_CODENAME=noble
MKP_BASE_IMAGE_VARIANT=server
MKP_HID_BACKEND=physical-configfs
MKP_HID_KEYBOARD_DEVICE=/dev/hidg0
MKP_HID_MOUSE_DEVICE=/dev/hidg1
MKP_GADGET_MODULE_HINTS='libcomposite usb_f_hid usb_f_mass_storage'
MKP_HOSTNAME_DEFAULT=mkp-hid-opi
MKP_USER_DEFAULT=mkp
MKP_HDMI_ENABLED=1
MKP_HDMI_DISP_MODE=1080p60
MKP_CONSOLE=both
MKP_DASHBOARD_TTY=/dev/tty1
