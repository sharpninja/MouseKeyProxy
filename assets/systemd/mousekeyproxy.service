[Unit]
Description=MouseKeyProxy gRPC service (Linux HID gadget peer)
Documentation=https://github.com/sharpninja/MouseKeyProxy
After=network-online.target sys-kernel-config.mount mkp-hid-gadget.service
Wants=network-online.target
Wants=mkp-hid-gadget.service

[Service]
Type=simple
# The service must run as root to open /dev/hidg0 and /dev/hidg1.
User=root
WorkingDirectory=/opt/mousekeyproxy
EnvironmentFile=-/etc/mousekeyproxy/status.env
ExecStart=/opt/mousekeyproxy/MouseKeyProxy.Service
Environment=MKP_HID_KEYBOARD_DEVICE=/dev/hidg0
Environment=MKP_HID_MOUSE_DEVICE=/dev/hidg1
# Plug-n-play: advertise on the LAN while unpaired and accept the first (codeless) ToFU pairing.
Environment=MKP_TOFU=1
Environment=MKP_STATE_DIR=/var/lib/mousekeyproxy
Restart=on-failure
RestartSec=5
# Logs flow to journald (the service uses AddSystemdConsole on Linux).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

